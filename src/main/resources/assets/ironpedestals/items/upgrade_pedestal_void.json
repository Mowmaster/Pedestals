{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "pedestals:upgrade_mode_display",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "pedestals:upgrade_mode_display",
      "cases": [
        {
          "when": {
            "type": "mowlib:items",
            "enabled": true
          },
          "model": {
            "type": "minecraft:model",
            "model": "pedestals:item/upgrades/void/items_on"
          }
        },
        {
          "when": {
            "type": "mowlib:items",
            "enabled": false
          },
          "model": {
            "type": "minecraft:model",
            "model": "pedestals:item/upgrades/void/items_off"
          }
        },
        {
          "when": {
            "type": "mowlib:fluids",
            "enabled": true
          },
          "model": {
            "type": "minecraft:model",
            "model": "pedestals:item/upgrades/void/fluids_on"
          }
        },
        {
          "when": {
            "type": "mowlib:fluids",
            "enabled": false
          },
          "model": {
            "type": "minecraft:model",
            "model": "pedestals:item/upgrades/void/fluids_off"
          }
        },
        {
          "when": {
            "type": "mowlib:energy",
            "enabled": true
          },
          "model": {
            "type": "minecraft:model",
            "model": "pedestals:item/upgrades/void/energy_on"
          }
        },
        {
          "when": {
            "type": "mowlib:energy",
            "enabled": false
          },
          "model": {
            "type": "minecraft:model",
            "model": "pedestals:item/upgrades/void/energy_off"
          }
        },
        {
          "when": {
            "type": "mowlib:experience",
            "enabled": true
          },
          "model": {
            "type": "minecraft:model",
            "model": "pedestals:item/upgrades/void/experience_on"
          }
        },
        {
          "when": {
            "type": "mowlib:experience",
            "enabled": false
          },
          "model": {
            "type": "minecraft:model",
            "model": "pedestals:item/upgrades/void/experience_off"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "pedestals:item/upgrade_pedestal_void"
      }
    },
    "on_false": {
      "type": "minecraft:model",
      "model": "pedestals:item/upgrades/void/items_on"
    }
  }
}
